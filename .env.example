# Backend
DATABASE_URL=postgresql://fina:fina@localhost:5432/fina
NODE_ENV=development
PORT=4000

# Better Auth — required
BETTER_AUTH_SECRET=replace-with-32+-char-random-string-from-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4000

# OAuth providers — optional but recommended
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_NATIVE_CLIENT_IDS=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_TEAM_ID=

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Fina <noreply@withfina.com>"

WEB_APP_URL=http://localhost:3000

# Plaid (sandbox to start; promote PLAID_ENV later for production)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

ENCRYPTION_KEY=
PLAID_WEBHOOK_URL=
PLAID_SANDBOX_ACCESS_TOKEN=
# Mobile (Expo public)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Web (Next.js public)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini (categorize — Plan 1B-categorize)
# Get an API key at https://aistudio.google.com/app/apikey (free tier OK).
GEMINI_API_KEY=

# Required by env.ts (post-merge)
TRUST_PROXY=false

# Stripe billing — REPLACE these 4 with your dashboard values
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MAX_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PORTAL_CONFIGURATION=

CRON_ENABLED=
EXPO_ACCESS_TOKEN=
DEEPSEEK_API_KEY=
