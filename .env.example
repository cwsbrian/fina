# Backend
DATABASE_URL=postgresql://fina:fina@localhost:5432/fina
NODE_ENV=development
PORT=4000

# Better Auth — required
BETTER_AUTH_SECRET=replace-with-32+-char-random-string-from-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4000

# OAuth providers — optional but recommended
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_TEAM_ID=

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Fina <noreply@withfina.com>"
WAITLIST_TO=cwsbrian@gmail.com
WAITLIST_FROM="Fina <noreply@withfina.com>"
WEB_APP_URL=http://localhost:3000

# Plaid (sandbox to start; promote PLAID_ENV later for production)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Public URL Plaid hits for webhooks (e.g. Tailscale Funnel: https://<machine>.<tailnet>.ts.net/plaid/webhook)
# Optional — leave blank for unit tests / local dev without Funnel.
PLAID_WEBHOOK_URL=

# AES-256-GCM key for Plaid access_token at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# DeepSeek (LLM chat, categorize, brief, title, goals, budgets)
# Get an API key from the DeepSeek platform. The default model is deepseek-v4-flash.
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash

# Prisma connection pool. 10 is the default; tune higher under heavy
# cron + webhook traffic.
PRISMA_CONNECTION_LIMIT=10

# Trust X-Forwarded-For when behind a load balancer / CDN. MUST be set
# explicitly — no default. Set to "true" ONLY if your deployment is
# behind a CDN/LB that strips client-set X-Forwarded-For headers. Setting
# true without that infrastructure lets attackers spoof their source IP.
# In dev / direct-connection deployments, set "false".
TRUST_PROXY=false

# Set to "1" only in rate-limit integration tests. Leave blank
# otherwise. NODE_ENV=test without this skips rate-limit registration.
RATE_LIMIT_TEST=

# Stripe (billing — Plan billing-stripe)
# Sign up at https://dashboard.stripe.com/register (free, test mode by default).
# WEB_APP_URL above is reused for success/cancel/return URLs — no separate var needed.
# Use a Restricted Key (rk_*) scoped to just what Fina needs — write
# on Customers / Subscriptions / Subscription Schedules / Checkout
# Sessions / Billing Portal; read on Products / Prices.
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MAX_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxx
# App-scoped Portal Configuration so adding a second app to this same
# Stripe account later doesn't pollute Fina's portal UI. Leave blank
# to fall back to Stripe's Default configuration.
STRIPE_PORTAL_CONFIGURATION=

# Plan 2C push notifications. Optional — free tier sends without auth.
# Set in production to raise Expo rate limits + enable receipt polling
# (future). Get from https://expo.dev/accounts/<acct>/settings/access-tokens
EXPO_ACCESS_TOKEN=

# Mobile (Expo public)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Web (Next.js public)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
