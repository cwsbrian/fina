# Backend
DATABASE_URL=postgresql://fina:fina@localhost:5432/fina
NODE_ENV=development
PORT=4000

# Better Auth — required
BETTER_AUTH_SECRET=replace-with-32+-char-random-string-from-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4000

# OAuth providers — optional but recommended
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_TEAM_ID=

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Fina <noreply@fina.app>"
WEB_APP_URL=http://localhost:3000

# Plaid (sandbox to start; promote PLAID_ENV later for production)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Public URL Plaid hits for webhooks (e.g. Tailscale Funnel: https://<machine>.<tailnet>.ts.net/plaid/webhook)
# Optional — leave blank for unit tests / local dev without Funnel.
PLAID_WEBHOOK_URL=

# AES-256-GCM key for Plaid access_token at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Gemini (categorize — Plan 1B-categorize)
# Get an API key at https://aistudio.google.com/app/apikey (free tier OK).
GEMINI_API_KEY=

# Mobile (Expo public)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Web (Next.js public)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
