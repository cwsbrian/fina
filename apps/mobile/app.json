{
  "expo": {
    "name": "Fina",
    "slug": "fina",
    "scheme": "fina",
    "version": "1.3",
    "orientation": "portrait",
    "icon": "./assets/fina-app-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/fina-login-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071F1D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.withfina.app",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Fina sends a daily morning brief notification.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.withfina.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/fina-adaptive-icon.png",
        "backgroundColor": "#071F1D"
      }
    },
    "web": {
      "favicon": "./assets/fina-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/fina-notification-icon.png",
          "color": "#000000"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "react-native-iap",
        {
          "paymentProvider": "both"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdfb302d-2a78-422b-bcd4-5e69ba0a7b03"
      }
    },
    "owner": "cwsbrian"
  }
}
