{
  "build": {
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.withfina.com",
        "EXPO_PUBLIC_WEB_URL": "https://withfina.com"
      }
    },
    "playtest": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.30.164:4000",
        "EXPO_PUBLIC_WEB_URL": "http://192.168.30.164:3100"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.30.164:4000",
        "EXPO_PUBLIC_WEB_URL": "http://192.168.30.164:3100",
        "FINA_IOS_ALLOW_LOCAL_NETWORKING": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.30.164:4000",
        "EXPO_PUBLIC_WEB_URL": "http://192.168.30.164:3100",
        "FINA_LOCAL_BUILD": "1"
      }
    },
    "preview-aab": {
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.30.164:4000",
        "EXPO_PUBLIC_WEB_URL": "http://192.168.30.164:3100",
        "FINA_LOCAL_BUILD": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
