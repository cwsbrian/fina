generator client {
  provider = "prisma-client-js"
  // nativeDistinct: Prisma's default `distinct` is applied client-side after fetching all rows,
  // which is unbounded for the GET /chat/threads first-message-preview query (N threads × M
  // messages each). Enabling this preview feature makes `distinct` translate to native
  // `DISTINCT ON` SQL, which is O(N) at the DB layer.
  previewFeatures = ["nativeDistinct"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Better Auth -----
model User {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Fina extensions
  tz               String    @default("America/Toronto")
  locale           String    @default("en-CA")
  trialStartedAt   DateTime?
  trialEndsAt      DateTime?
  trialConsumed    Boolean   @default(false)
  stripeCustomerId String?   @unique // Billing — set on first Stripe checkout

  // Plan 2B daily brief settings.
  // morningTime: validated by PatchMeBody zod (API is sole writer).
  // No DB-level CHECK constraint.
  morningTime  String    @default("08:00")
  snoozeUntil  DateTime?
  pauseEnabled Boolean   @default(false)

  categorizationMode CategorizationMode @default(flexible)

  // IAP binding tokens — deterministic per-user identifiers used by
  // webhook handlers as the fallback path when the Subscription row
  // doesn't yet exist (first-purchase race, Android resubscribe).
  // Written on first successful /billing/iap/checkout. Identifiers,
  // not authenticators — see spec §3.
  iapAppleAccountToken    String?  @unique
  iapGoogleObfuscatedId   String?  @unique

  /// Per-type push notification preferences. Shape:
  ///   { morningBrief, bankReconnect, workspaceInvites, trialExpiring,
  ///     goalMilestones, largeCharges, productUpdates: boolean }
  /// Missing keys read as the type's default (see libs/shared/src/notifications.ts).
  notificationPrefs Json?

  /// Idempotency for the trial-expiring push: stores the last threshold
  /// (5, 3, or 1) we pushed for so we don't repeat each day inside the
  /// same threshold band.
  lastTrialPushDays Int?

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // Fina relations
  memberships     Membership[]
  invitesSent     Invite[]     @relation("InvitesSent")
  invitesAccepted Invite[]     @relation("InvitesAccepted")
  plaidItems      PlaidItem[]
  actionIntents   ActionIntent[]
  chatThreads     ChatThread[]
  subscriptions   Subscription[]
  briefs          Brief[]
  devices UserDevice[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ----- Fina core -----
model Workspace {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  currency           String        @default("CAD")
  memberships        Membership[]
  invites            Invite[]
  plaidItems         PlaidItem[]
  bankAccounts       BankAccount[]
  transactions       Transaction[]
  categories         Category[]
  merchantMappings   MerchantMapping[]
  chatThreads        ChatThread[]
  budgets            Budget[]
  recurringExpenses  RecurringExpense[]
  actionIntents      ActionIntent[]
  auditEvents        AuditEvent[]
  scheduledSpends    ScheduledSpend[]
  goals              Goal[]
  budgetPlans        BudgetPlan[]

  @@map("workspaces")
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

enum Role {
  owner
  editor
  viewer
}

model Invite {
  id           String       @id @default(cuid())
  workspaceId  String
  invitedEmail String // stored lowercase
  invitedRole  Role // editor | viewer (owner not allowed via API)
  invitedById  String
  tokenHash    String       @unique // SHA-256 hex of the raw bearer token; raw is only sent in the email
  status       InviteStatus @default(pending)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([invitedEmail, status])
  @@map("invites")
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

model PlaidItem {
  id                    String          @id @default(cuid())
  workspaceId           String
  connectedBy           String? // userId of the member who connected this item
  // AES-256-GCM. AAD = workspaceId so a row swapped between workspaces won't decrypt.
  // Layout: ciphertext bytes followed by 16-byte auth tag.
  accessTokenCiphertext Bytes
  accessTokenIv         Bytes // 12 bytes
  itemId                String          @unique // Plaid item_id; second exchange retry hits P2002
  institutionId         String
  institutionName       String
  status                PlaidItemStatus @default(active)
  errorCode             String?
  lastSyncAt            DateTime?
  lastCursor            String?
  // Webhook URL registered with Plaid for this item (per §1B-webhooks).
  // NULL for items connected before the webhook feature shipped — startup task backfills them.
  webhookUrl            String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SetNull so workspace data survives if the connecting user leaves/is deleted.
  user            User?                  @relation(fields: [connectedBy], references: [id], onDelete: SetNull)
  bankAccounts    BankAccount[]
  transactions    Transaction[]
  webhookEvents   PlaidWebhookEvent[]    @relation("PlaidItemWebhookEvents")

  @@index([workspaceId])
  @@index([connectedBy])
  @@map("plaid_items")
}

enum PlaidItemStatus {
  active
  error
  relink_required
  disconnected
}

// Mirrors every status Stripe can send so the webhook can write the
// value verbatim without enum-validation failures. Only `trialing` /
// `active` / `past_due` count as active for EffectiveTier — see
// apps/api/src/auth/tier.ts.
enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  unpaid               // final state after Smart Retries exhausted
  incomplete           // first invoice never settled
  incomplete_expired   // Checkout abandoned, auto-canceled by Stripe
  paused               // admin-paused; rare
}

// Source-agnostic per design spec §13.7. Only `stripe` populated in
// v1; iap_* future-proof for the mobile billing PR.
enum SubscriptionSource {
  stripe
  iap_apple
  iap_google
}

model PlaidWebhookEvent {
  id            String    @id @default(cuid())
  // NULL when item_id is not in our DB (disconnected item, stale Plaid delivery).
  plaidItemId   String?
  webhookType   String    // e.g. "TRANSACTIONS"
  webhookCode   String    // e.g. "SYNC_UPDATES_AVAILABLE"
  // Raw Plaid body — audit trail. No unique constraint:
  // SYNC_UPDATES_AVAILABLE bodies are identical across deliveries once
  // initial_update_complete=true; body-hash dedup would silently drop
  // legitimate events. Sync's cursor + row-level lock handles duplicates.
  body          Json
  receivedAt    DateTime  @default(now())
  // Set by detached dispatchWebhookSync after sync+categorize completes (or fails).
  // NULL while in-flight, when webhook type wasn't dispatched, OR when sync hit lock_held
  // (so 1B-cron can retry — competing sync may have started before this delta existed).
  processedAt   DateTime?
  processError  String?   // ≤500 chars; full stack to structured log.

  plaidItem PlaidItem? @relation("PlaidItemWebhookEvents", fields: [plaidItemId], references: [id], onDelete: SetNull)

  @@index([plaidItemId, receivedAt])
  @@index([webhookType, webhookCode])
  @@map("plaid_webhook_events")
}

model BankAccount {
  id                String        @id @default(cuid())
  workspaceId       String
  plaidItemId       String?
  // Plaid account_ids are globally unique per Plaid's contract — global UNIQUE
  // is fine. Transaction.plaidTransactionId uses a workspace-scoped partial
  // UNIQUE because it's only unique per workspace.
  plaidAccountId    String?       @unique
  name              String
  officialName      String?
  mask              String?
  type              String
  subtype           String?
  currency          String        @default("CAD")
  status            AccountStatus @default(active)
  balanceCurrent    Decimal?      @db.Decimal(14, 2)
  balanceAvailable  Decimal?      @db.Decimal(14, 2)
  balanceLimit      Decimal?      @db.Decimal(14, 2)
  lastBalanceSyncAt DateTime?
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SetNull (NOT Cascade) — disconnect must keep accounts (and via them, transactions)
  // as history. Disconnect handler also stamps archivedAt so UI can hide them.
  plaidItem    PlaidItem?    @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([workspaceId, plaidItemId])
  @@map("bank_accounts")
}

enum AccountStatus {
  active
  closed
  hidden
}

model Transaction {
  id                        String            @id @default(cuid())
  workspaceId               String
  accountId                 String
  plaidItemId               String?
  plaidTransactionId        String?
  plaidPendingTransactionId String?
  amount                    Decimal           @db.Decimal(14, 2)
  merchantRaw               String
  merchantNormalized        String?
  occurredAt                DateTime
  postedAt                  DateTime?
  pending                   Boolean           @default(false)
  source                    TransactionSource @default(plaid)
  rawData                   Json
  note                      String?
  removedAt                 DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  needsReclassification     Boolean           @default(false)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // FK column kept as `accountId` (not `bankAccountId`) so URL/query filters
  // and prior plan-2 code that exposes accountId in API responses don't churn.
  // The Prisma model is BankAccount but the field name is unchanged.
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidItem   PlaidItem?  @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  allocations      TransactionAllocation[]
  matchedSchedules ScheduledSpend[] @relation("ScheduledSpendMatch")

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([workspaceId, accountId, occurredAt(sort: Desc)])
  @@map("transactions")
}

model TransactionAllocation {
  id            String                @id @default(cuid())
  transactionId String
  categoryId    String?
  amount        Decimal               @db.Decimal(14, 2)
  source        CategorizationSource?
  needsConfirmation Boolean   @default(false)
  dismissedUntil    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([categoryId])
  @@index([categoryId, transactionId])
  @@map("transaction_allocations")
}

model ScheduledSpend {
  id            String    @id @default(cuid())
  workspaceId   String
  categoryId    String
  amount        Decimal   @db.Decimal(14, 2)
  scheduledDate DateTime  @db.Date
  note          String?
  matchedTxId   String?
  dismissedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  matchedTx Transaction? @relation("ScheduledSpendMatch", fields: [matchedTxId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scheduledDate])
  @@index([workspaceId, categoryId, scheduledDate])
  @@index([matchedTxId])
  @@map("scheduled_spends")
}

enum TransactionSource {
  plaid
  manual
  csv
}

model Category {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  parentId    String?
  icon        String?
  color       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent             Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]        @relation("CategoryTree")
  allocations        TransactionAllocation[]
  scheduledSpends    ScheduledSpend[]
  merchantMappings   MerchantMapping[]
  budgets            Budget[]
  recurringExpenses  RecurringExpense[]
  goalAllocations    GoalAllocation[]

  @@map("categories")
}

model Budget {
  id           String   @id @default(cuid())
  workspaceId  String
  categoryId   String
  amount       Decimal  @db.Decimal(10, 2)
  periodStart  DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, categoryId, periodStart])
  @@index([workspaceId, periodStart])
  @@map("budgets")
}

/// Monthly budget plan — a total cap with optional per-category split.
/// `periodStart = '1900-01-01'` is the sentinel value for the user's
/// "default" template; every other row is a real month and is
/// auto-snapshotted from the default on first access. Edits to a
/// monthly snapshot do NOT propagate back to the default.
/// `categoryAllocations` is `Array<{ categoryId: string, amount: number }>`
/// — empty array when the user opts not to break the total down.
model BudgetPlan {
  id                  String   @id @default(cuid())
  workspaceId         String
  periodStart         DateTime @db.Date
  totalAmount         Decimal  @db.Decimal(14, 2)
  categoryAllocations Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart])
  @@index([workspaceId])
  @@map("budget_plans")
}

/// User-defined savings goal — "save $2,000 for a trip by Nov".
/// `savedAmount` is a manual figure for v1; user updates it via PATCH.
/// `icon` + `color` mirror the Category styling pattern so the UI can
/// render a consistent badge.
model Goal {
  id            String    @id @default(cuid())
  workspaceId   String
  title         String
  description   String?
  targetAmount  Decimal   @db.Decimal(14, 2)
  savedAmount   Decimal   @default(0) @db.Decimal(14, 2)
  dueDate       DateTime  @db.Date
  icon          String?
  color         String?
  /// LLM-generated metadata for the savings plan: { generatedAt: ISO,
  /// notice?: string }. Per-category allocations live in GoalAllocation
  /// with proper FKs — this column is only for the generator's notice
  /// + timestamp.
  strategy      Json?
  /// Highest savings-milestone (25/50/75/100) we've already pushed for.
  /// Cron compares current pct against this and only sends when we cross
  /// upward; never re-fires when savings dip back below the line.
  lastMilestonePct Int?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  allocations   GoalAllocation[]

  @@index([workspaceId, dueDate])
  @@map("goals")
}

/// Per-category piece of a Goal's savings plan. Generated by the LLM,
/// rewritten on every strategy regeneration. The (goalId, categoryId)
/// unique index keeps it tidy if the LLM picks the same category twice.
model GoalAllocation {
  id            String   @id @default(cuid())
  goalId        String
  categoryId    String
  /// Planned monthly cut from this category, in workspace currency.
  monthlyAmount Decimal  @db.Decimal(14, 2)
  /// LLM's one-line justification for this row, shown verbatim in the UI.
  rationale     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goal     Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([goalId, categoryId])
  @@index([categoryId])
  @@map("goal_allocations")
}

enum RecurringCadence {
  monthly
  semimonthly
  biweekly
  weekly
  yearly
}

model RecurringExpense {
  id                  String           @id @default(cuid())
  workspaceId         String
  name                String
  nameNormalized      String
  amount              Decimal          @db.Decimal(10, 2)
  categoryId          String?
  merchantNormalized  String?
  cadence             RecurringCadence
  nextOccurrenceDate  DateTime         @db.Date
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, nameNormalized])
  @@index([workspaceId, nextOccurrenceDate])
  @@map("recurring_expenses")
}

model ActionIntent {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  messageId   String?
  kind        String
  payload     Json
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId],      references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, expiresAt])
  @@map("action_intents")
}

model MerchantMapping {
  id                  String         @id @default(cuid())
  workspaceId         String
  // Lowercased, stripped of store IDs/state codes/city qualifiers.
  // E.g. "STARBUCKS #1234 TORONTO ON" → "starbucks".
  // See apps/api/src/categorize/normalize.ts for the exact rules.
  merchantNormalized  String
  categoryId          String
  // 0.00 – 1.00. Manual confirms = 1.00. Reserved for confidence-weighted
  // UI (Phase 2) — stored but not consumed in Plan 1B.
  confidence          Decimal        @default(1.00) @db.Decimal(3, 2)
  source              MappingSource
  createdAt           DateTime       @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId],  references: [id], onDelete: Cascade)

  @@unique([workspaceId, merchantNormalized])
  @@index([workspaceId])
  @@map("merchant_mappings")
}

enum MappingSource {
  manual
  ai
  auto
}

enum CategorizationSource {
  mapping
  ai
  manual
  history
}

enum CategorizationMode {
  flexible
  strict
  auto
}

model ChatThread {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String?
  title         String?
  lastMessageAt DateTime?
  lastReadAt    DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  // Supports the chat-thread listing query at apps/api/src/chat/threads.ts:
  //   findMany WHERE userId = ? ORDER BY archivedAt ASC, lastMessageAt DESC NULLS LAST.
  // Prisma 5.5+ supports the `nulls` keyword in @@index — that's why this
  // can finally live in schema instead of raw migration SQL.
  @@index([userId, archivedAt, lastMessageAt(sort: Desc, nulls: Last)])
  @@map("chat_threads")
}

model ChatMessage {
  id        String          @id @default(cuid())
  threadId  String
  role      ChatMessageRole
  blocks    Json
  createdAt DateTime        @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  brief  Brief?

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

enum ChatMessageRole {
  user
  assistant
  tool
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorType   String
  actorUserId String
  action      String
  targetType  String?
  targetId    String?
  intentId    String?
  payload     Json?
  result      Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_events")
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "lite" | "pro" — String not Prisma enum because it must match
  // @fina/shared Tier union (free|lite|pro) exactly. Validated by
  // tierForPriceId() at write boundaries; free never appears here.
  tier   String
  source SubscriptionSource
  // Stripe "sub_..."
  sourceSubscriptionId String
  // Stripe "cus_..."; mirrors User.stripeCustomerId for query convenience.
  sourceCustomerId String?

  status            SubscriptionStatus
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean @default(false)
  // "monthly" | "annual" — annual deferred to v1.5+ per spec.
  billingPeriod String @default("monthly")

  // When a downgrade or upgrade is scheduled at the end of the current
  // billing period (via stripe.subscriptionSchedules or Portal's
  // "switch plan at period end" flow), these capture the upcoming
  // change. Both are set/cleared together on every sync — null means
  // no scheduled change.
  pendingTier   String?
  pendingTierAt DateTime?

  /// "Production" | "Sandbox" — derived from verified transaction's
  /// `environment` claim (Apple) or v2 response's sandbox flag (Google).
  /// Defaults to "Production" for existing Stripe rows. buildMeBody /
  /// effectiveTier filter out rows where this disagrees with the
  /// runtime APPLE_ENV / google env to prevent stale sandbox rows
  /// from granting prod entitlement.
  environment       String   @default("Production")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceSubscriptionId])
  @@index([userId, status])
  @@map("subscriptions")
}

// Stores enough to dedupe; no body retained (PII + volume).
model WebhookEvent {
  // Stripe event.id ("evt_...") — also serves as idempotency key.
  id          String   @id
  source      String
  type        String
  receivedAt  DateTime @default(now())

  /// Optional structured payload for forensic event types
  /// (unattributable_after_delete / unattributable_giveup / etc.).
  /// Existing Stripe dedup rows leave this null. PII fields covered
  /// by Pino redact list (Task 0).
  body  Json?

  @@index([source, type])
  @@map("webhook_events")
}

enum BriefType {
  daily
  weekly
  monthly
}

/// Daily-brief idempotency record. One per (userId, date) in user's tz.
/// Created atomically with the ChatMessage that holds the brief content
/// (see apps/api/src/cron/jobs/daily-brief.ts).
model Brief {
  id        String    @id @default(cuid())
  userId    String
  type      BriefType
  /// ISO date "YYYY-MM-DD" in user's tz at generation time. Text not
  /// DateTime so date-portion comparisons are tz-stable even if user.tz
  /// changes between briefs. Lexical sort = chronological.
  date      String
  messageId String    @unique
  createdAt DateTime  @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, type, date])
  @@map("briefs")
}

model UserDevice {
  id              String    @id @default(cuid())
  userId          String
  /// Expo's "ExponentPushToken[xxx]" format string. Opaque to us; Expo
  /// translates to APNs (iOS) or FCM (Android) device tokens internally.
  expoPushToken   String
  /// "ios" or "android". TEXT not enum so non-target platforms (future
  /// web push, desktop, etc.) can be added without a Prisma migration.
  platform        String
  /// Updated on every register/refresh call (per app foreground / launch).
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets         PushTicket[]

  @@unique([userId, expoPushToken])
  @@index([userId])
  @@map("user_devices")
}

model PushTicket {
  id              String       @id @default(cuid())
  /// Expo가 반환하는 ticket id (e.g., "019e5181-c4e6-7488..."). UNIQUE
  /// — 같은 ticket을 2번 저장 시도하면 conflict (방어용).
  expoTicketId    String       @unique
  userDeviceId    String
  sentAt          DateTime     @default(now())
  /// null = 아직 poll 안 함. Polling 성공 시 now(). 7일 후 cleanup-events 정리.
  polledAt        DateTime?
  /// null | "ok" | "error". status="error"일 때 errorCode 동반.
  status          String?
  /// "DeviceNotRegistered" | "InvalidCredentials" | "MessageTooBig" 등.
  errorCode       String?

  userDevice      UserDevice   @relation(fields: [userDeviceId], references: [id], onDelete: Cascade)

  @@index([polledAt, sentAt])
  @@map("push_tickets")
}

/// Tombstone for IAP bindings whose `User` row was deleted. Webhook
/// handlers consult this to stop retrying notifications for purchases
/// that will never resolve to a Fina user. Forensic-only — never read
/// by /me or any user-facing route.
model IapDeletedBinding {
  id         String   @id @default(cuid())
  source     String   // "iap_apple" | "iap_google"
  /// SHA-256 of the binding token. Hashed so the deleted-user
  /// identifier is not recoverable from this table.
  tokenHash  String
  /// Optional SHA-256 of the original userId for support-replay.
  userIdHash String?
  deletedAt  DateTime @default(now())

  @@unique([source, tokenHash])
  @@index([source])
  @@map("iap_deleted_bindings")
}

/// Tracks per-binding-token retry counts for the IAP unattributable-
/// renewal fallback (spec §5.3 step 4). Distinct from WebhookEvent
/// (which is keyed on notificationUUID/messageId and is the DEDUP
/// surface) — Apple's real retries deliver the SAME notificationUUID,
/// so retry-cap must be keyed on the binding token instead. After
/// MAX_UNKNOWN_RETRIES (5) the webhook returns 200 with a forensic
/// WebhookEvent so the store stops retrying.
model IapRetryCounter {
  id         String   @id @default(cuid())
  source     String   // "iap_apple" | "iap_google"
  /// SHA-256 of the binding token (appAccountToken / obfuscatedExternalAccountId).
  tokenHash  String
  attempts   Int      @default(0)
  firstAt    DateTime @default(now())
  lastAt     DateTime @default(now())

  @@unique([source, tokenHash])
  @@map("iap_retry_counters")
}
