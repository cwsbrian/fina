generator client {
  provider = "prisma-client-js"
  // nativeDistinct: Prisma's default `distinct` is applied client-side after fetching all rows,
  // which is unbounded for the GET /chat/threads first-message-preview query (N threads × M
  // messages each). Enabling this preview feature makes `distinct` translate to native
  // `DISTINCT ON` SQL, which is O(N) at the DB layer.
  previewFeatures = ["nativeDistinct"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Better Auth -----
model User {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Fina extensions
  tz             String    @default("America/Toronto")
  locale         String    @default("en-CA")
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  trialConsumed  Boolean   @default(false)

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // Fina relations
  memberships     Membership[]
  invitesSent     Invite[]     @relation("InvitesSent")
  invitesAccepted Invite[]     @relation("InvitesAccepted")
  plaidItems      PlaidItem[]
  actionIntents   ActionIntent[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ----- Fina core -----
model Workspace {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships        Membership[]
  invites            Invite[]
  plaidItems         PlaidItem[]
  bankAccounts       BankAccount[]
  transactions       Transaction[]
  categories         Category[]
  merchantMappings   MerchantMapping[]
  chatThreads        ChatThread[]
  budgets            Budget[]
  recurringExpenses  RecurringExpense[]
  actionIntents      ActionIntent[]

  @@map("workspaces")
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

enum Role {
  owner
  editor
  viewer
}

model Invite {
  id           String       @id @default(cuid())
  workspaceId  String
  invitedEmail String // stored lowercase
  invitedRole  Role // editor | viewer (owner not allowed via API)
  invitedById  String
  tokenHash    String       @unique // SHA-256 hex of the raw bearer token; raw is only sent in the email
  status       InviteStatus @default(pending)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([invitedEmail, status])
  @@map("invites")
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

model PlaidItem {
  id                    String          @id @default(cuid())
  workspaceId           String
  connectedBy           String? // userId of the member who connected this item
  // AES-256-GCM. AAD = workspaceId so a row swapped between workspaces won't decrypt.
  // Layout: ciphertext bytes followed by 16-byte auth tag.
  accessTokenCiphertext Bytes
  accessTokenIv         Bytes // 12 bytes
  itemId                String          @unique // Plaid item_id; second exchange retry hits P2002
  institutionId         String
  institutionName       String
  status                PlaidItemStatus @default(active)
  errorCode             String?
  lastSyncAt            DateTime?
  lastCursor            String?
  // Webhook URL registered with Plaid for this item (per §1B-webhooks).
  // NULL for items connected before the webhook feature shipped — startup task backfills them.
  webhookUrl            String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SetNull so workspace data survives if the connecting user leaves/is deleted.
  user            User?                  @relation(fields: [connectedBy], references: [id], onDelete: SetNull)
  bankAccounts    BankAccount[]
  transactions    Transaction[]
  webhookEvents   PlaidWebhookEvent[]    @relation("PlaidItemWebhookEvents")

  @@index([workspaceId])
  @@index([connectedBy])
  @@map("plaid_items")
}

enum PlaidItemStatus {
  active
  error
  relink_required
  disconnected
}

model PlaidWebhookEvent {
  id            String    @id @default(cuid())
  // NULL when item_id is not in our DB (disconnected item, stale Plaid delivery).
  plaidItemId   String?
  webhookType   String    // e.g. "TRANSACTIONS"
  webhookCode   String    // e.g. "SYNC_UPDATES_AVAILABLE"
  // Raw Plaid body — audit trail. No unique constraint:
  // SYNC_UPDATES_AVAILABLE bodies are identical across deliveries once
  // initial_update_complete=true; body-hash dedup would silently drop
  // legitimate events. Sync's cursor + row-level lock handles duplicates.
  body          Json
  receivedAt    DateTime  @default(now())
  // Set by detached dispatchWebhookSync after sync+categorize completes (or fails).
  // NULL while in-flight, when webhook type wasn't dispatched, OR when sync hit lock_held
  // (so 1B-cron can retry — competing sync may have started before this delta existed).
  processedAt   DateTime?
  processError  String?   // ≤500 chars; full stack to structured log.

  plaidItem PlaidItem? @relation("PlaidItemWebhookEvents", fields: [plaidItemId], references: [id], onDelete: SetNull)

  @@index([plaidItemId, receivedAt])
  @@index([webhookType, webhookCode])
  @@map("plaid_webhook_events")
}

model BankAccount {
  id                String        @id @default(cuid())
  workspaceId       String
  plaidItemId       String?
  // Plaid account_ids are globally unique per Plaid's contract — global UNIQUE
  // is fine. Transaction.plaidTransactionId uses a workspace-scoped partial
  // UNIQUE because it's only unique per workspace.
  plaidAccountId    String?       @unique
  name              String
  officialName      String?
  mask              String?
  type              String
  subtype           String?
  currency          String        @default("CAD")
  status            AccountStatus @default(active)
  balanceCurrent    Decimal?      @db.Decimal(14, 2)
  balanceAvailable  Decimal?      @db.Decimal(14, 2)
  balanceLimit      Decimal?      @db.Decimal(14, 2)
  lastBalanceSyncAt DateTime?
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SetNull (NOT Cascade) — disconnect must keep accounts (and via them, transactions)
  // as history. Disconnect handler also stamps archivedAt so UI can hide them.
  plaidItem    PlaidItem?    @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([workspaceId, plaidItemId])
  @@map("bank_accounts")
}

enum AccountStatus {
  active
  closed
  hidden
}

model Transaction {
  id                        String            @id @default(cuid())
  workspaceId               String
  accountId                 String
  plaidItemId               String?
  plaidTransactionId        String?
  plaidPendingTransactionId String?
  amount                    Decimal           @db.Decimal(14, 2)
  currency                  String            @default("CAD")
  merchantRaw               String
  merchantNormalized        String?
  categoryId                String?
  occurredAt                DateTime
  postedAt                  DateTime?
  pending                   Boolean           @default(false)
  source                    TransactionSource @default(plaid)
  rawData                   Json
  note                      String?
  removedAt                 DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  categorizationSource      CategorizationSource?

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // FK column kept as `accountId` (not `bankAccountId`) so URL/query filters
  // and prior plan-2 code that exposes accountId in API responses don't churn.
  // The Prisma model is BankAccount but the field name is unchanged.
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidItem PlaidItem?  @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  category  Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([workspaceId, accountId, occurredAt(sort: Desc)])
  @@index([workspaceId, categoryId])
  @@map("transactions")
}

enum TransactionSource {
  plaid
  manual
  csv
}

model Category {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  parentId    String?
  icon        String?
  color       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent             Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]        @relation("CategoryTree")
  transactions       Transaction[]
  merchantMappings   MerchantMapping[]
  budgets            Budget[]
  recurringExpenses  RecurringExpense[]

  @@map("categories")
}

model Budget {
  id           String   @id @default(cuid())
  workspaceId  String
  categoryId   String
  amount       Decimal  @db.Decimal(10, 2)
  periodStart  DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, categoryId, periodStart])
  @@index([workspaceId, periodStart])
  @@map("budgets")
}

enum RecurringCadence {
  monthly
  semimonthly
  biweekly
  weekly
  yearly
}

model RecurringExpense {
  id                  String           @id @default(cuid())
  workspaceId         String
  name                String
  nameNormalized      String
  amount              Decimal          @db.Decimal(10, 2)
  currency            String           @default("CAD")
  categoryId          String?
  merchantNormalized  String?
  cadence             RecurringCadence
  nextOccurrenceDate  DateTime         @db.Date
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, nameNormalized])
  @@index([workspaceId, nextOccurrenceDate])
  @@map("recurring_expenses")
}

model ActionIntent {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  messageId   String?
  kind        String
  payload     Json
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId],      references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, expiresAt])
  @@map("action_intents")
}

model MerchantMapping {
  id                  String         @id @default(cuid())
  workspaceId         String
  // Lowercased, stripped of store IDs/state codes/city qualifiers.
  // E.g. "STARBUCKS #1234 TORONTO ON" → "starbucks".
  // See apps/api/src/categorize/normalize.ts for the exact rules.
  merchantNormalized  String
  categoryId          String
  // 0.00 – 1.00. Manual confirms = 1.00. Reserved for confidence-weighted
  // UI (Phase 2) — stored but not consumed in Plan 1B.
  confidence          Decimal        @default(1.00) @db.Decimal(3, 2)
  source              MappingSource
  createdAt           DateTime       @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId],  references: [id], onDelete: Cascade)

  @@unique([workspaceId, merchantNormalized])
  @@index([workspaceId])
  @@map("merchant_mappings")
}

enum MappingSource {
  manual
  ai
  auto
}

enum CategorizationSource {
  mapping
  ai
  manual
}

model ChatThread {
  id            String    @id @default(cuid())
  workspaceId   String
  title         String?
  lastMessageAt DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  // NOTE: list-by-recency index is created by the migration SQL with
  // `lastMessageAt DESC NULLS LAST`. Prisma's @@index syntax cannot express
  // NULLS LAST, so omitting the directive here avoids schema drift. The
  // engineer should resist adding it back in `prisma migrate dev` outputs.
  @@map("chat_threads")
}

model ChatMessage {
  id        String          @id @default(cuid())
  threadId  String
  role      ChatMessageRole
  blocks    Json
  createdAt DateTime        @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

enum ChatMessageRole {
  user
  assistant
  tool
}
