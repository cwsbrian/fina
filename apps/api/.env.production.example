# =============================================================================
# Fina API — production env template
# =============================================================================
# Copy to Coolify's env panel (NOT to a .env file checked into git).
# `?` mark = optional. Everything else is required for the API to boot.
#
# Validation: src/env.ts (zod). Boot fails fast with the offending key listed.
# =============================================================================

NODE_ENV=production
PORT=4000

# ----- Database -----
# Coolify-provisioned Postgres. Use the *internal* hostname (the service name
# inside the Coolify network) so traffic doesn't leave the host.
# Suffix ?connection_limit= to override the default pool (env.PRISMA_CONNECTION_LIMIT).
DATABASE_URL=postgresql://fina:CHANGEME@postgres:5432/fina?schema=public

# ----- Auth (Better Auth) -----
# Generate: openssl rand -base64 48 | tr -d '=+/' | cut -c1-48
BETTER_AUTH_SECRET=CHANGEME_AT_LEAST_32_CHARS_OF_RANDOM
BETTER_AUTH_URL=https://api.withfina.com
WEB_APP_URL=https://withfina.com

# Google OAuth (optional — only if "Sign in with Google" enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated native OAuth client IDs accepted for mobile idToken sign-in.
GOOGLE_NATIVE_CLIENT_IDS=

# ----- Email (Resend) -----
# Required in prod: must start with re_ and be ≥24 chars.
RESEND_API_KEY=re_CHANGEME
EMAIL_FROM=Fina <noreply@withfina.com>

# ----- Stripe -----
# Live keys (sk_live_..., whsec_..., price_...). Use TEST keys before launch.
STRIPE_SECRET_KEY=sk_live_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME
STRIPE_PRICE_PRO_MONTHLY=price_CHANGEME
STRIPE_PRICE_MAX_MONTHLY=price_CHANGEME
# Optional: per-app Stripe Customer Portal configuration ID (cfg_...).
STRIPE_PORTAL_CONFIGURATION=

# ----- Plaid -----
# Production credentials require Plaid dashboard approval (1-2 weeks).
# Start with development creds + PLAID_ENV=development if not yet approved.
PLAID_CLIENT_ID=CHANGEME
PLAID_SECRET=CHANGEME
PLAID_ENV=production
# Webhook URL — must be HTTPS and publicly reachable. Cloudflare-proxied.
PLAID_WEBHOOK_URL=https://api.withfina.com/plaid/webhook

# ----- Encryption (Plaid access_token at-rest) -----
# AES-256-GCM key. Must base64-decode to EXACTLY 32 bytes.
# Generate: openssl rand -base64 32
# DO NOT rotate without re-encrypting plaid_item.accessTokenCipher rows.
ENCRYPTION_KEY=CHANGEME_BASE64_32_BYTES

# ----- Gemini (chat + categorize) -----
GEMINI_API_KEY=CHANGEME

# ----- Reverse-proxy trust -----
# REQUIRED — no default. Set to "true" because Cloudflare → Coolify Traefik
# both add X-Forwarded-For. If you bypass the proxy this MUST be false or
# rate-limit buckets become spoofable.
TRUST_PROXY=true

# ----- Scheduler -----
# Enable in prod (cron jobs: Plaid sync, daily digest, receipts, milestones).
CRON_ENABLED=true
# Optional overrides (defaults in code)
# CRON_EVENT_TTL_DAYS=30
# SCHEDULED_SPEND_TTL_DAYS=90

# ----- Push (Expo) -----
# Optional but RECOMMENDED in prod: raises Expo Push rate limits and unlocks
# receipt polling. Create at https://expo.dev/settings/access-tokens
EXPO_ACCESS_TOKEN=

# ----- Apple IAP (mobile, optional) -----
# Required only when shipping IAP on iOS. Until then leave blank.
APPLE_BUNDLE_ID=com.withfina.app
APPLE_ASC_ISSUER_ID=
APPLE_ASC_KEY_ID=
APPLE_APP_APPLE_ID=
APPLE_ASC_PRIVATE_KEY=
APPLE_ENV=production

# ----- Google IAP (mobile, optional) -----
GOOGLE_PACKAGE_NAME=com.withfina.app
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_VERIFY_AUDIENCE=
GOOGLE_PUBSUB_VERIFY_EMAIL=
GOOGLE_PUBSUB_SUBSCRIPTION_NAME=

# ----- Prisma pool size -----
# Default 10. Bump on bigger boxes (CX23 = 10 is fine; CX33 → 20).
# PRISMA_CONNECTION_LIMIT=10

# ----- Chat tuning -----
# Recommended for production: Flash (better tool-call accuracy on 28 tools
# + Konglish/Korean nuance). Cost difference vs flash-lite is negligible
# (~$0.0004 vs $0.0002 per chat turn) and per-user $5/mo budget gate
# absorbs heavy users.
CHAT_MODEL=gemini-2.5-flash
# 16k tokens of history per call (~150 last messages). Code default also
# 16k; set explicitly so the value is visible in ops runbooks.
CHAT_HISTORY_BUDGET_TOKENS=16000
# Tighter overrides if cost spikes appear post-launch:
# CHAT_HISTORY_LIMIT_MESSAGES=40
# CHAT_MAX_TOOL_CALLS_PER_TURN=8
