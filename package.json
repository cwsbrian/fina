{
  "name": "fina",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev --parallel=10",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "_comment_smoke": "Plan 2 smoke test — see docs/superpowers/smoke-tests/2026-05-08-plan-2-workspace-sharing.md. Postgres dev container is on port 5433 (host has another Postgres on 5432). LAN scripts hardcode 100.65.93.102 — edit if your Tailscale/LAN IP changes. The repo .env is owned by root and points at port 5432; we override DATABASE_URL inline so we don't have to touch it.",
    "smoke:api": "RESEND_API_KEY= DATABASE_URL=postgresql://fina:fina@localhost:5433/fina WEB_APP_URL=http://localhost:3100 nx run api:dev",
    "smoke:api:lan": "RESEND_API_KEY= DATABASE_URL=postgresql://fina:fina@localhost:5433/fina WEB_APP_URL=http://100.65.93.102:3100 BETTER_AUTH_URL=http://100.65.93.102:4000 DEV_ORIGINS=http://100.65.93.102:3100 nx run api:dev",
    "smoke:web": "pnpm --filter @fina/web smoke",
    "smoke:web:lan": "pnpm --filter @fina/web smoke:lan",
    "smoke:db:studio": "DATABASE_URL=postgresql://fina:fina@localhost:5433/fina pnpm --filter @fina/api db:studio",
    "smoke:db:migrate": "DATABASE_URL=postgresql://fina:fina@localhost:5433/fina pnpm --filter @fina/api db:migrate",
    "smoke:db:reset": "docker exec fina-postgres-dev psql -U fina -d fina -c 'TRUNCATE TABLE invites, memberships, workspaces, verifications, sessions, accounts, users RESTART IDENTITY CASCADE;'",
    "smoke:db:start": "docker start fina-postgres-dev",
    "smoke:db:stop": "docker stop fina-postgres-dev",
    "smoke:test": "DATABASE_URL=postgresql://fina:fina@localhost:5433/fina_test nx run-many -t test",
    "e2e": "DATABASE_URL=postgresql://fina:fina@localhost:5433/fina API_URL=http://localhost:4000 WEB_URL=http://localhost:3100 playwright test",
    "e2e:ui": "DATABASE_URL=postgresql://fina:fina@localhost:5433/fina API_URL=http://localhost:4000 WEB_URL=http://localhost:3100 playwright test --ui",
    "e2e:headed": "DATABASE_URL=postgresql://fina:fina@localhost:5433/fina API_URL=http://localhost:4000 WEB_URL=http://localhost:3100 playwright test --headed"
  },
  "devDependencies": {
    "@babel/runtime": "7.24.5",
    "@eslint/compat": "^1.1.1",
    "@expo/cli": "~0.18.13",
    "@nx/esbuild": "19.8.14",
    "@nx/eslint": "19.8.14",
    "@nx/eslint-plugin": "19.8.14",
    "@nx/expo": "19.8.14",
    "@nx/jest": "19.8.14",
    "@nx/js": "19.8.14",
    "@nx/next": "19.8.14",
    "@nx/node": "19.8.14",
    "@nx/vite": "19.8.14",
    "@nx/web": "19.8.14",
    "@nx/workspace": "19.8.14",
    "@playwright/test": "^1.60.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/jest-native": "~5.4.3",
    "@testing-library/react-native": "~12.5.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.5",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.3.1",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~11.0.0",
    "esbuild": "^0.19.2",
    "eslint": "^9.13.0",
    "eslint-config-next": "14.2.3",
    "eslint-plugin-import": "2.30.0",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "~51.0.2",
    "nx": "19.8.14",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^5.0.0",
    "vitest": "^1.3.1"
  },
  "dependencies": {
    "@expo/metro-config": "~0.18.1",
    "@expo/metro-runtime": "~3.2.1",
    "expo": "~51.0.8",
    "expo-splash-screen": "~0.27.4",
    "expo-status-bar": "~1.12.1",
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.74.1",
    "react-native-svg": "15.2.0",
    "react-native-svg-transformer": "1.3.0",
    "react-native-web": "~0.19.11",
    "tslib": "^2.3.0"
  }
}
